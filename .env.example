# Copy to .env and adjust. Docker Compose reads it automatically.

# personal: one owner, open unless you set a password in Settings.  team: accounts, roles and sign-in.
KNWLGE_MODE=personal

# Address and port to listen on. 0.0.0.0 = every interface; 127.0.0.1 = only this machine (e.g. behind a proxy).
KNWLGE_BIND=0.0.0.0
KNWLGE_PORT=9180

# Host names the app answers to, besides IP addresses, localhost and single-word names (guards against DNS
# rebinding). Comma-separated; wildcards allowed, e.g. learn.example.org,*.internal.example.org
KNWLGE_ALLOWED_HOSTS=

# Time zone for "this month" in the budget.
TZ=America/Los_Angeles
